{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ],
  "redirects": [
    { "source": "/gk-signature", "destination": "https://gksignature.vercel.app/", "permanent": false },
    { "source": "/na-chethi-kala", "destination": "/naa-cheti-kala", "permanent": true },
    { "source": "/nck", "destination": "/naa-cheti-kala", "permanent": false }
  ]
}
